<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="PJ.NavigationTrans.Sample.NewPage1"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	Title="NewPage1">

	<VerticalStackLayout>
		<Label
			HorizontalOptions="Center"
			Text="THis is Page 1"
			VerticalOptions="Center" />

		<VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
			<Picker
				x:Name="animationIn"
				Title="Animation In"
				SelectedIndexChanged="animationIn_SelectedIndexChanged" />

			<Picker
				x:Name="animationOut"
				Title="Animation Out"
				SelectedIndexChanged="animationOut_SelectedIndexChanged" />

			<Button Clicked="Button_Clicked" Text="Navigate" />
		</VerticalStackLayout>
	</VerticalStackLayout>
</ContentPage>